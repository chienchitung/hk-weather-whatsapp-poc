# CallMeBot credentials (required only when DRY_RUN=false)
CALLMEBOT_PHONE=+852XXXXXXXX
CALLMEBOT_API_KEY=replace_me

# Notification safety
DRY_RUN=true
BOOTSTRAP_SILENT=true

# Source polling
RSS_MAX_AGE_HOURS=12
REQUEST_TIMEOUT_SECONDS=15

# State backend
# Local development: local
# Cloud Run / production-like PoC: firestore
STATE_BACKEND=local
STATE_PATH=/tmp/hk-weather-whatsapp-state.json
FIRESTORE_COLLECTION=hk_weather_notification_state

PORT=8080
