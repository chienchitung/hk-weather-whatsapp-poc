# CallMeBot credentials for single-recipient fallback
# Used only when RECIPIENTS_SHEET_ID is empty and DRY_RUN=false
CALLMEBOT_PHONE=+852XXXXXXXX
CALLMEBOT_API_KEY=replace_me

# Multi-recipient Google Sheet
# Required columns in the Recipients sheet: name | phone | api_key
RECIPIENTS_SHEET_ID=
RECIPIENTS_SHEET_RANGE=Recipients!A:C

# Notification safety
DRY_RUN=true
BOOTSTRAP_SILENT=true

# Source polling
RSS_MAX_AGE_HOURS=12
REQUEST_TIMEOUT_SECONDS=15

# State backend
# Local development: local
# Cloud Run / long-running PoC: firestore
STATE_BACKEND=local
STATE_PATH=/tmp/hk-weather-whatsapp-state.json
FIRESTORE_COLLECTION=hk_weather_notification_state

PORT=8080
